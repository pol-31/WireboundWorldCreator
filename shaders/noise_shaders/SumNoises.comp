void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    ivec2 texSize = imageSize(bottom_layer);

    // Convert texel to [-1,1] object space (pivot at 0,0)
    vec2 uv = (vec2(coord) + 0.5) / vec2(texSize);
    vec2 obj = uv * 2.0 - 1.0;   // now (-1..1) range

    // Rotate point around pivot
    vec4 rotated = transform * vec4(obj, 0.0, 1.0);

    // Back to [0..1] texture UVs
    vec2 topUV = mod((rotated.xy * 0.5 + 0.5) * vec2(texSize), vec2(texSize));
//    topUV = vec2(1.0f) / topUV;
//    vec2 topUV = (rotated.xy * 0.5 + 0.5) * vec2(texSize);

    // Sample with bounds check
    float top = 0.0;
    if (all(greaterThanEqual(topUV, vec2(0.0))) &&
    all(lessThan(topUV, vec2(texSize)))) {
        top = imageLoad(top_layer, ivec2(topUV)).r;
    }

//    float top = imageLoad(top_layer, coord).r;
    float bottom = imageLoad(bottom_layer, coord).r;

    // --- compute angle factor ---
    // local Z axis after transform = transform * (0,0,1,0)
    vec3 localZ = normalize((transform * vec4(0,0,1,0)).xyz);

    // how much it points “up” in world space (0..1)
    float angleFactor = abs(localZ.z);

    float result = bottom + top * (1.0 - angleFactor);
    imageStore(bottom_layer, coord, vec4(result));
}
